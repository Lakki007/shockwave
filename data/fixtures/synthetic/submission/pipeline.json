{
  "model_file": "backdoored.safetensors",
  "deployment": "tinydet-v1",
  "preprocess": {
    "resize": [
      256,
      256
    ],
    "channel_order": "RGB",
    "normalize": "unit"
  },
  "postprocess": {
    "score_threshold": 0.25,
    "max_detections": 1,
    "class_map": {
      "jet": "drone"
    }
  }
}